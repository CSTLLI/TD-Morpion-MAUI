<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Garde les namespaces existants (TD_Morpion_MAUI.Models, .Services, .ViewModels) -->
        <RootNamespace>TD_Morpion_MAUI</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <!-- Color/Colors (agnostique, pas besoin de tout MAUI) -->
        <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.20" />
    </ItemGroup>

    <ItemGroup>
        <!-- Reproduit le global using implicite que MAUI fournissait avant l'extraction -->
        <Using Include="Microsoft.Maui.Graphics" />
    </ItemGroup>

</Project>
